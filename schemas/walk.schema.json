{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "walk.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "source",
    "counts"
  ],
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "counts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goal",
          "friction",
          "count"
        ],
        "properties": {
          "goal": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "friction": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
